# Server settings
server:
  host: "0.0.0.0"  # Interface to bind to
  port: 5003       # Port to listen on
  access_key: "dummy-key"  # Authentication key (clients send as x-api-key header)
  log_level: "INFO"  # Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
  http_log_level: "INFO"  # HTTP access logs level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
  request_detail_log: true  # Log each incoming request as a curl command

