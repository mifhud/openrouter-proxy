# Anthropic-compatible Proxy Configuration

# Server settings
server:
  host: "0.0.0.0"  # Default interface
  port: 5003        # Default port
  access_key: "your_local_access_key_here"  # Key for accessing the local proxy (clients send as x-api-key)
  log_level: "INFO"  # Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
  http_log_level: "INFO"  # HTTP access logs level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
  request_detail_log: false  # Log each incoming request as a curl command

# Kilo.ai API keys (Anthropic-compatible)
anthropic:
  keys:
    - "your-kilo-api-key-1"
    - "your-kilo-api-key-2"
    - "your-kilo-api-key-3"

  # Key selection strategy: "round-robin" (default), "first" or "random".
  key_selection_strategy: "round-robin"
  # List of key selection options:
  #   "same": Always use the last used key as long as it is possible.
  key_selection_opts: []

  # Kilo.ai Anthropic-compatible API base URL
  base_url: "https://api.kilo.ai/v1"

  # Public endpoints that don't require authentication
  public_endpoints:
    - "/v1/models"

  # Time in seconds to temporarily disable a key when rate limit is reached
  rate_limit_cooldown: 14400  # 4 hours

# Proxy settings for outgoing requests
requestProxy:
  enabled: false    # Set to true to enable proxy
  url: "socks5://username:password@example.com:1080"  # Proxy URL with optional credentials embedded
